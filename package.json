{
  "name": "json-buddy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local JSON workspace, compare, stream monitor and mock server.",
  "license": "MIT",
  "scripts": {
    "sync:ui": "node scripts/sync-ui.mjs",
    "dev": "node scripts/sync-ui.mjs && vite --config vite.ui.config.ts",
    "build": "node scripts/sync-ui.mjs && tsc --noEmit && vite build --config vite.ui.config.ts",
    "dev:react": "vite",
    "build:react": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:debug": "node scripts/tauri-debug.mjs",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
